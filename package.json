{
  "name": "macroflow",
  "version": "1.0.0",
  "description": "MacroFlow - Save and run macros with a beautiful GUI, supporting both concurrent and sequential execution",
  "author": "Anish Patel",
  "main": "electron/main.js",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "macos": "react-native run-macos",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "electron": "electron .",
    "electron-dev": "NODE_ENV=development electron .",
    "electron-pack": "electron-builder",
    "build:macos": "npm run electron-pack -- --mac && npm run organize:macos",
    "organize:macos": "mkdir -p dist/macos && mv dist/*.dmg dist/*.zip dist/macos/ 2>/dev/null || true && mv dist/mac-* dist/macos/ 2>/dev/null || true && rm -f dist/*.blockmap dist/latest-mac.yml dist/builder-debug.yml",
    "clean:dist": "rm -rf dist/* && mkdir -p dist/macos",
    "webpack": "webpack --config webpack.web.config.js",
    "webpack-dev": "webpack serve --config webpack.web.config.js --mode development --port 3000",
    "dev": "./dev.sh",
    "dev:clean": "./scripts/uninstall-alias.sh && npm run dev",
    "clean": "rm -rf node_modules package-lock.json && npm install",
    "electron-web": "npm run webpack-dev & sleep 3 && npm run electron-dev"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.72.6",
    "react-native-macos": "0.72.6",
    "react-native-vector-icons": "^10.0.0",
    "react-native-fs": "^2.20.0",
    "react-native-zip-archive": "^6.1.0",
    "react-native-document-picker": "^9.0.1",
    "react-native-permissions": "^3.10.1",
    "@react-native-async-storage/async-storage": "^1.19.3",
    "react-native-svg": "^13.14.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-dom": "18.2.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/eslint-config": "^0.72.2",
    "@react-native/metro-config": "^0.72.11",
    "@types/react": "^18.0.24",
    "@types/react-test-renderer": "^18.0.0",
    "@types/react-dom": "18.2.0",
    "@types/uuid": "^9.0.0",
    "babel-jest": "^29.2.1",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "0.76.8",
    "prettier": "^2.4.1",
    "react-test-renderer": "18.2.0",
    "typescript": "4.8.4",
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "ts-loader": "^9.5.1",
    "style-loader": "^3.3.3",
    "css-loader": "^6.8.1",
    "html-webpack-plugin": "^5.5.3"
  },
  "build": {
    "appId": "com.macroflow.app",
    "productName": "MacroFlow",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "build/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "electron/assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    }
  },
  "jest": {
    "preset": "react-native"
  },
  "eslintConfig": {
    "extends": "@react-native/eslint-config"
  }
}
